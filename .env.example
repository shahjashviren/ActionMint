# Backend only (copy to .env at repository root for local development)
ENV=dev
# Include the exact local frontend URL, plus your deployed ActionMint frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROVIDER_CHAIN=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_VIDEO_MODEL=gemini-3.8-flash
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
MAX_MEDIA_MB=100
MAX_MEDIA_MIN=20
MAX_TRANSCRIPT_CHARS=60000
SESSION_TTL_SECONDS=1800
